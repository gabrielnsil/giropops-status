# Copie pra terraform.tfvars e ajuste.
# terraform.tfvars NÃO deve ir pro git (já está no .gitignore).

# Região AWS onde a EC2 vai subir
aws_region = "us-east-1"

# Tipo da instância (t3.micro = free tier)
instance_type = "t3.micro"

# Versão do Ubuntu (LTS recomendado)
# jammy-22.04 ou noble-24.04
ubuntu_release = "noble-24.04"

# Cole o conteúdo da sua chave pública SSH aqui (ssh-keygen -t ed25519)
# Deixe vazio pra não criar key pair (EC2 sobe sem SSH).
ssh_public_key = ""

# CIDRs permitidos pra SSH (porta 22)
# RECOMENDADO: restringir ao seu IP, ex: ["177.18.42.10/32"]
# Descobrir seu IP atual: curl -s ifconfig.me
ssh_allowed_cidrs = ["0.0.0.0/0"]
